# Copy this file to `.env` and adjust values as needed.
# Never commit the real `.env` file (it's in .gitignore).

APP_NAME="VidSense AI"
DEBUG=true

# Faster-Whisper transcription settings.
# This dev machine has only a 2GB-VRAM/old-driver GPU, so CPU + int8 is
# the practical default. Change WHISPER_DEVICE=cuda only on a machine
# with a real CUDA-capable GPU and matching torch build.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Max upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=1024

# FFmpeg binary. Bare name resolves via PATH; override with a full path
# if ffmpeg isn't on PATH on a given machine.
FFMPEG_BINARY=ffmpeg
