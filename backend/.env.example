# Copy this file to `.env` and adjust values as needed.
# Never commit the real `.env` file (it's in .gitignore).

APP_NAME="VidSense AI"
DEBUG=true

# Faster-Whisper transcription settings.
# This dev machine has only a 2GB-VRAM/old-driver GPU, so CPU + int8 is
# the practical default. Change WHISPER_DEVICE=cuda only on a machine
# with a real CUDA-capable GPU and matching torch build.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Max upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=1024

# FFmpeg binary. Bare name resolves via PATH; override with a full path
# if ffmpeg isn't on PATH on a given machine.
FFMPEG_BINARY=ffmpeg

# LLM provider for RAG answer generation. "ollama" is the only
# implementation today -- swappable later via this one value (see
# app/services/llm_service.py) without changing any calling code.
#
# IMPORTANT (this machine's GPU): Ollama's default backend probes for a GPU
# via Vulkan and finds the GeForce MX230, which crashes llama-server (it
# doesn't support 16-bit storage). Fix: set OLLAMA_LLM_LIBRARY=cpu as a
# Windows environment variable (not here -- it configures the Ollama
# service itself, not this app) and restart Ollama. See README.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# A small (~2GB), CPU-runnable instruction-tuned model, chosen for this
# machine's 8GB total RAM shared with everything else already running.
OLLAMA_MODEL=qwen2.5:3b
LLM_REQUEST_TIMEOUT_SECONDS=120
# How many top search results get passed to the LLM as context per question.
RAG_CONTEXT_CHUNKS=5

# Frame extraction (Phase 5). One candidate frame every N seconds, then a
# near-duplicate check (mean pixel diff below FRAME_DIFF_THRESHOLD skips
# a frame that looks like the same slide still on screen).
FRAME_SAMPLE_INTERVAL_SECONDS=5.0
FRAME_DIFF_THRESHOLD=10.0
